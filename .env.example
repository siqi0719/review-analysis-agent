# 复制本文件为 .env，并填入你自己的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 评论批量提取用：便宜、并发高
LLM_MODEL_EXTRACT=deepseek-flash
# 对话 Agent 与日报用：推理更强
LLM_MODEL_CHAT=deepseek-v4-pro

# 可选：轮询间隔（分钟），默认 60
# POLL_MINUTES=60
# 可选：监控目录，默认 桌面\评论数据
# WATCH_DIR=D:\some\folder
